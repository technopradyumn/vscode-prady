{
  "name": "prady-lang",
  "displayName": "Prady Language",
  "description": "Full IDE support for Prady (.pr) — diagnostics, go-to-definition (Ctrl+Click), hover, auto-complete, symbols, run & check commands",
  "version": "1.0.4",
  "publisher": "technopradyumn",
  "license": "MIT OR Apache-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/technopradyumn/vscode-prady"
  },
  "homepage": "https://github.com/technopradyumn/vscode-prady",
  "bugs": { "url": "https://github.com/technopradyumn/vscode-prady/issues" },
  "engines": { "vscode": "^1.75.0" },
  "main": "./extension.js",
  "scripts": {
    "package": "vsce package",
    "test": "node --test",
    "publish": "vsce publish",
    "publish-ovsx": "ovsx publish prady-lang-1.0.4.vsix -p"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.22.0"
  },
  "categories": ["Programming Languages", "Snippets", "Linters"],
  "keywords": ["prady", "pr", "systems programming", "syntax highlighting", "architecture-as-code"],
  "activationEvents": ["onLanguage:prady"],
  "contributes": {
    "languages": [
      {
        "id": "prady",
        "aliases": ["Prady", "prady"],
        "extensions": [".pr"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/prady-file-icon.png",
          "dark":  "./icons/prady-file-icon.png"
        }
      }
    ],
    "iconThemes": [
      {
        "id": "prady-icons",
        "label": "Prady File Icons",
        "path": "./icons/prady-icon-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "prady",
        "scopeName": "source.prady",
        "path": "./syntaxes/prady.tmLanguage.json"
      }
    ],
    "snippets": [
      { "language": "prady", "path": "./snippets/prady.json" }
    ],
    "commands": [
      {
        "command": "prady.runFile",
        "title": "Prady: Run File",
        "icon": "$(play)"
      },
      {
        "command": "prady.checkFile",
        "title": "Prady: Check File",
        "icon": "$(check)"
      },
      {
        "command": "prady.showAst",
        "title": "Prady: Show AST"
      },
      {
        "command": "prady.showOutput",
        "title": "Prady: Show LSP Output"
      },
      {
        "command": "prady.organizeImports",
        "title": "Prady: Organize Imports",
        "icon": "$(list-ordered)"
      }
    ],
    "keybindings": [
      {
        "command": "prady.runFile",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus && resourceLangId == prady"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "prady.runFile",
          "when": "resourceLangId == prady",
          "group": "navigation"
        },
        {
          "command": "prady.checkFile",
          "when": "resourceLangId == prady",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "prady.runFile",
          "when": "resourceLangId == prady",
          "group": "prady"
        },
        {
          "command": "prady.checkFile",
          "when": "resourceLangId == prady",
          "group": "prady"
        },
        {
          "command": "prady.showAst",
          "when": "resourceLangId == prady",
          "group": "prady"
        }
      ]
    },
    "configuration": {
      "title": "Prady",
      "properties": {
        "prady.executablePath": {
          "type": "string",
          "default": "prady",
          "description": "Path to the prady CLI executable"
        },
        "prady.lspServerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the prady-lsp binary (leave empty for auto-detection)"
        }
      }
    },
    "problemMatchers": [
      {
        "name": "prady",
        "owner": "prady",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": [
          {
            "regexp": "^(error|warning)(?:\\[([^\\]]+)\\])?:\\s*(.*)$",
            "severity": 1,
            "code": 2,
            "message": 3
          },
          {
            "regexp": "^\\s*-->\\s*(.*?):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "loop": true
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "prady",
        "required": ["task"],
        "properties": {
          "task": {
            "type": "string",
            "description": "Prady task to run",
            "enum": ["run", "check", "test", "ast"]
          },
          "file": {
            "type": "string",
            "description": "Target .pr file"
          }
        }
      }
    ]
  }
}
