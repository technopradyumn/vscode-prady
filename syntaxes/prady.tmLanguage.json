{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Prady",
  "scopeName": "source.prady",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#annotations" },
    { "include": "#keywords" },
    { "include": "#class-declarations" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#function-declarations" },
    { "include": "#function-calls" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.prady",
          "match": "//.*$"
        },
        {
          "name": "comment.block.prady",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.prady",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.prady",
              "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[nrt\\\\\"'0])"
            }
          ]
        },
        {
          "name": "string.quoted.single.prady",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.prady",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "entity.name.tag.decorator.prady",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.prady",
          "match": "\\b(if|else|while|for|foreach|of|in|switch|case|default|loop|return|break|continue|match|yield|try|catch|throw)\\b"
        },
        {
          "name": "keyword.declaration.prady",
          "match": "\\b(fn|let|mut|const|struct|interface|class|trait|enum|type|architecture|layer|spec|contract|impl|abstract)\\b"
        },
        {
          "name": "keyword.other.prady",
          "match": "\\b(pub|private|protected|static|async|await|use|import|export|module|using|extends|implements|cannot|requires|ensures|invariant|where)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.prady",
          "match": "\\b(Int|Int8|Int16|Int32|Int64|UInt|UInt8|UInt16|UInt32|UInt64|Float|Float32|Float64|Bool|Char|String|Void|Unit|Never)\\b"
        },
        {
          "name": "support.type.container.prady",
          "match": "\\b(Option|Result|Array|List|Map|Set|Vec|Tuple|Stack|Queue|Deque|MinHeap|MaxHeap|LinkedList|DoublyLinkedList|BST|AVLTree|RedBlackTree|Trie|Graph|LRUCache|LFUCache|CircularBuffer|BloomFilter|DisjointSet|SegmentTree|FenwickTree|BitSet|SkipList|Matrix|SparseMatrix|TreeMap|TreeSet)\\b"
        },
        {
          "name": "entity.name.type.prady",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.prady",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.prady",
          "match": "\\b(null|nil|None|Some|Ok|Err)\\b"
        },
        {
          "name": "support.function.builtin.prady",
          "match": "\\b(print|println|assert|panic|len|sizeof|type_of|input|format)\\b"
        }
      ]
    },
    "class-declarations": {
      "patterns": [
        {
          "match": "\\b(class|struct)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.prady" },
            "2": { "name": "entity.name.class.prady" }
          }
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.prady" },
            "2": { "name": "entity.name.function.prady" }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.prady" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.prady",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.prady",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.float.prady",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.prady",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.prady",
          "match": "(->|=>)"
        },
        {
          "name": "keyword.operator.comparison.prady",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.prady",
          "match": "(\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.prady",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.prady",
          "match": "(&&|\\|\\||!)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.prady",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.bracket.prady",
          "match": "[\\[\\]\\{\\}\\(\\)]"
        }
      ]
    }
  }
}
